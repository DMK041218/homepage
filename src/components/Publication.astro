---
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  abstract: string;
  pubDate: string;
  heroImage: ImageMetadata | string;
  conference: string;
  href?: string;
  authors: string;
}

const myName = "Mingkang Dong";

const { title, abstract, pubDate, heroImage, conference, href, authors, ...props } = Astro.props;

const boldMyName = authors.replace(myName, `<strong>${myName}</strong>`);
---

<article class="publication-card" {...props}>
  <a href={href} class="pub-link">
    <div class="pub-image">
      {typeof heroImage === 'string' ? (
        <img src={heroImage} alt={title} loading="lazy"/>
      ) : (
        <img src={heroImage.src} alt={title} loading="lazy"/>
      )}
    </div>
    
    <div class="pub-content">
      <div class="pub-header">
        <div class="pub-status">
          <span class="pub-conference">{conference}</span>
          <span class="pub-date">{pubDate}</span>
        </div>
        <h3 class="pub-title">{title}</h3>
        <span class="pub-authors" set:html={boldMyName}></span>
      </div>
      
      <p class="pub-abstract">{abstract}</p>
    </div>
  </a>
</article>

<style>
  .publication-card {
    display: block;
    margin-bottom: 1rem;
    transition: transform 0.2s ease;
  }

  .pub-link {
    display: flex;
    gap: 1.15rem;
    padding: 1rem;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e5e7eb;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pub-link:hover {
    border-color: #93c5fd;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    transform: translateY(-1px);
  }
  
  .pub-image {
    flex-shrink: 0;
    width: 190px;
    height: 118px;
    overflow: hidden;
    border-radius: 6px;
    background: #f8fafc;
    border: 1px solid #eef2f7;
  }

  .pub-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .pub-link:hover .pub-image img {
    transform: scale(1.05);
  }

  .pub-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .pub-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pub-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .pub-authors {
    font-size: 0.82rem;
    line-height: 1.35;
    color: #374151;
  }

  .pub-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.28;
    margin: 0;
    color: #111827;
    transition: color 0.2s ease;
  }

  .pub-link:hover .pub-title {
    color: #3b82f6;
  }

  .pub-conference {
    font-weight: 700;
    color: #1d4ed8;
    font-size: 0.74rem;
    line-height: 1;
    padding: 0.28rem 0.5rem;
    border-radius: 999px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
  }

  .pub-date {
    color: #64748b;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .pub-abstract {
    color: #4b5563;
    line-height: 1.45;
    margin: 0;
    font-size: 0.78rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .pub-link {
      flex-direction: column;
      gap: 0.85rem;
      padding: 0.9rem;
    }

    .pub-image {
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .pub-title {
      font-size: 1rem;
    }

    .pub-abstract {
      -webkit-line-clamp: 4;
    }
  }
</style>
